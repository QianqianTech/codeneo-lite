{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "codeneo-lite",
  "version": "0.1.7",
  "identifier": "app.claudekeeper.lite",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "CodeNeo Lite",
      "titleBarStyle": "Overlay",
      "hiddenTitle": true,
      "trafficLightPosition": { "x": 13, "y": 20 },
      "width": 1080,
      "height": 760,
      "minWidth": 390,
      "minHeight": 560
    }],
    "security": { "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; form-action 'none'; base-uri 'none'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../mcp/playwright/node_modules/": "mcp/playwright/node_modules/"
    },
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "13.0" }
  }
}
