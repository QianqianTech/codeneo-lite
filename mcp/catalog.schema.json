{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeNeo Lite MCP directory",
  "type": "object",
  "required": ["version", "servers"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "servers": {
      "type": "array",
      "items": { "$ref": "#/$defs/server" }
    }
  },
  "$defs": {
    "server": {
      "type": "object",
      "required": ["id", "name", "category", "description", "source", "variants"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "pattern": "^https://", "format": "uri" },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/variant" }
        }
      }
    },
    "variant": {
      "type": "object",
      "required": ["transport", "endpoint"],
      "additionalProperties": false,
      "properties": {
        "clients": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["desktop", "code", "codex", "workbuddy", "opencode", "qwen", "codebuddy", "kimi", "copilot"] }
        },
        "transport": { "enum": ["stdio", "http", "sse"] },
        "endpoint": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "options": { "type": "object", "additionalProperties": { "type": "string" } },
        "input": { "$ref": "#/$defs/input" },
        "oauth": { "type": "boolean" },
        "requires": { "type": "string" },
        "note": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "transport": { "const": "stdio" } } },
          "then": {
            "properties": { "input": { "properties": { "target": { "enum": ["env", "directory"] } } } }
          },
          "else": {
            "properties": {
              "endpoint": { "pattern": "^https://", "format": "uri" },
              "input": { "properties": { "target": { "const": "header" } } }
            },
            "not": { "required": ["args"] }
          }
        }
      ]
    },
    "input": {
      "type": "object",
      "required": ["target", "label", "required"],
      "additionalProperties": false,
      "properties": {
        "target": { "enum": ["header", "env", "directory"] },
        "label": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "key": { "type": "string", "minLength": 1 },
        "prefix": { "type": "string" }
      },
      "if": { "properties": { "target": { "const": "directory" } } },
      "then": { "not": { "anyOf": [{ "required": ["key"] }, { "required": ["prefix"] }] } },
      "else": { "required": ["key"] }
    }
  }
}
